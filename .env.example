# Variables de entorno — CASI REAL MVP

# Origen canónico del sitio. Obligatorio en producción para indexación.
SITE_URL=https://casi-real.ejemplo.com

# Indexabilidad de motores de búsqueda. false por defecto; activa solo en el
# hostname de producción propio y tras revisar la configuración.
PUBLIC_INDEXABLE=false

# ID opcional de Google Analytics 4. Solo se activa cuando se configura;
# el sitio funciona completo sin analítica.
PUBLIC_GA4_ID=

# Nombre del sitio (sobrescribe el valor central de src/config/site.ts).
PUBLIC_SITE_NAME=CASI REAL
