---
import { seoHead } from '@/components/seo-head';
import { productCard } from '@/components/product-card';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import { site } from '@/config/site';
import { loadProducts } from '@/lib/products';
import { categoryBySlug } from '@/config/categories';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const cat = categoryBySlug(slug)!;
const products = (await loadProducts()).filter((p) => p.data.category === slug);

const title = `${cat.name} — Inventos imposibles | CASI REAL`;
const description = cat.intro;
const url = new URL(`/categorias/${slug}/`, site.url).href;
---

<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    {seoHead({ title, description, url, image: site.ogImage })}
    <style is:global>@import '/src/styles/global.css';</style>
  </head>
  <body>
    <Header />
    <main class="section">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <svg aria-hidden="true"><path d="M4 8l4 4 4-4" /></svg>
          <a href="/productos/">Catálogo</a>
          <svg aria-hidden="true"><path d="M4 8l4 4 4-4" /></svg>
          <span aria-current="page">{cat.name}</span>
        </nav>

        <p class="eyebrow" style={`color: var(--cat-${slug});`}>Categoría</p>
        <h1>{cat.heading}</h1>
        <p class="lead" style="margin-bottom:2rem;">{cat.intro}</p>

        <div class="product-grid" data-source={`category-${slug}`}>
          {products.map((p) => productCard({ product: p, source: `category-${slug}` }))}
        </div>
        {products.length === 0 && (
          <div class="empty-state">
            <h2>Esta categoría aún se está imaginando.</h2>
            <a href="/productos/" class="btn">Ver todo el catálogo</a>
          </div>
        )}
        <p style="margin-top:1.6rem;"><a href="/productos/">Ver todo el catálogo</a></p>
      </div>
    </main>
    <Footer />
    <script src="/scripts/bag-ui.js" defer></script>
  </body>
</html>
