---
import Analytics from '@/components/analytics.astro';
---
<header class="site-header">
  <div class="container">
    <a href="/" class="wordmark" aria-label="CASI REAL — tienda ficticia de inventos imposibles">
      <svg viewBox="0 0 64 64" fill="none" stroke-width="4" aria-hidden="true">
        <rect x="12" y="12" width="34" height="34" rx="6" />
        <rect x="20" y="20" width="34" height="34" rx="6" />
      </svg>
      <span>CASI REAL</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/productos/">Explorar</a></li>
        <li><a href="/categorias/trabajo/">Categorías</a></li>
        <li><a href="/regalos-imposibles/">Regalos imposibles</a></li>
        <li><a href="/como-funciona/">Cómo funciona</a></li>
        <li>
          <a href="/bolsa/" class="bag-link">Bolsa <span class="bag-count" aria-hidden="true">0</span><span class="sr-only">artículos en tu bolsa imaginaria</span></a>
        </li>
      </ul>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div id="mobile-menu" class="mobile-menu" hidden>
      <a href="/productos/">Explorar</a>
      <a href="/categorias/trabajo/">Categorías</a>
      <a href="/regalos-imposibles/">Regalos imposibles</a>
      <a href="/como-funciona/">Cómo funciona</a>
      <a href="/bolsa/">Bolsa imaginaria <span class="bag-count" aria-hidden="true">0</span></a>
    </div>
  </div>
</header>
<Analytics />
<script>
  import { loadBag, cartCount } from '@/lib/cart';

  const btn = document.querySelector('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  function setOpen(open: boolean) {
    if (!btn || !menu) return;
    menu.classList.toggle('open', open);
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }
  if (btn && menu) {
    btn.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  }

  function updateCount() {
    document.querySelectorAll('.bag-count').forEach((el) => {
      el.textContent = String(cartCount(loadBag()));
    });
  }
  updateCount();
  window.addEventListener('casi-real:bag-changed', updateCount);
</script>
