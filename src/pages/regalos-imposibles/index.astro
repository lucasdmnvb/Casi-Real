---
import { seoHead } from '@/components/seo-head';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import { site } from '@/config/site';

const title = 'Regala algo imposible | CASI REAL';
const description = 'Crea un regalo imposible: elige un invento, añade una dedicatoria y comparte una tarjeta ficticia. Gratis, sin pago, sin envío.';
const url = new URL('/regalos-imposibles/', site.url).href;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    {seoHead({ title, description, url, image: site.ogImage })}
    <style is:global>@import '/src/styles/global.css';</style>
  </head>
  <body>
    <Header />
    <section class="section">
      <div class="container">
        <h2 style="font-size:clamp(1.75rem,4vw,2.5rem); margin-bottom:0.4rem;">Regala algo que no existe. La sonrisa sí.</h2>
        <p style="color:var(--muted); max-width:var(--reading-max); margin:0 0 1.6rem;">
          Elige un invento, elige su versión y añade una dedicatoria opcional. Generamos un enlace y una tarjeta para imprimir. No hay compra, ni envío, ni datos de pago.
        </p>
        <form id="gift-form" novalidate>
          <div class="gift-step">
            <h3>1. Elige el regalo</h3>
            <div class="gift-options" role="radiogroup" aria-label="Producto">
              <button type="button" class="gift-option" data-p="clon-personal" data-v="reuniones" aria-pressed="false">
                <img src="/images/products/clon-personal.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Clon Personal 2.0</span>
                <span class="gift-option-credits">1.290 créditos imaginarios</span>
              </button>
              <button type="button" class="gift-option" data-p="cancelador-de-reuniones" data-v="alineamiento" aria-pressed="false">
                <img src="/images/products/cancelador-de-reuniones.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Cancelador de Reuniones Pro</span>
                <span class="gift-option-credits">640 créditos imaginarios</span>
              </button>
              <button type="button" class="gift-option" data-p="borrador-de-conversaciones" data-v="audio" aria-pressed="false">
                <img src="/images/products/borrador-de-conversaciones.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Borrador de Conversaciones</span>
                <span class="gift-option-credits">560 créditos imaginarios</span>
              </button>
              <button type="button" class="gift-option" data-p="traductor-de-pensamientos" data-v="planes" aria-pressed="false">
                <img src="/images/products/traductor-de-pensamientos.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Traductor de Pensamientos</span>
                <span class="gift-option-credits">970 créditos imaginarios</span>
              </button>
              <button type="button" class="gift-option" data-p="pausador-de-tiempo" data-v="despertador" aria-pressed="false">
                <img src="/images/products/pausador-de-tiempo.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Pausador de Tiempo Pocket</span>
                <span class="gift-option-credits">1.120 créditos imaginarios</span>
              </button>
              <button type="button" class="gift-option" data-p="recuperador-de-sueno" data-v="siesta" aria-pressed="false">
                <img src="/images/products/recuperador-de-sueno.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Recuperador de Sueño 3000</span>
                <span class="gift-option-credits">880 créditos imaginarios</span>
              </button>
              <button type="button" class="gift-option" data-p="clima-de-bolsillo" data-v="sol" aria-pressed="false">
                <img src="/images/products/clima-de-bolsillo.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Clima de Bolsillo Mini</span>
                <span class="gift-option-credits">730 créditos imaginarios</span>
              </button>
              <button type="button" class="gift-option" data-p="teletransportador-de-vacaciones" data-v="playa" aria-pressed="false">
                <img src="/images/products/teletransportador-de-vacaciones.svg" alt="" loading="lazy" width="600" height="600" />
                <span class="gift-option-name">Teletransportador de Vacaciones</span>
                <span class="gift-option-credits">1.880 créditos imaginarios</span>
              </button>
            </div>
          </div>
          <div class="gift-step">
            <h3>2. Dedicatoria (opcional)</h3>
            <div class="form-group">
              <label for="gift-to">Para</label>
              <input id="gift-to" type="text" placeholder="Nombre de la persona" maxlength="32" />
              <span class="char-count" id="gift-to-count">0 / 32</span>
            </div>
            <div class="form-group">
              <label for="gift-note">Mensaje</label>
              <textarea id="gift-note" rows="3" placeholder="Unas palabras…" maxlength="120"></textarea>
              <span class="char-count" id="gift-note-count">0 / 120</span>
            </div>
            <p class="hint">Si compartes este enlace, quien lo abra verá la dedicatoria. No incluyas información privada.</p>
          </div>
          <div class="gift-step">
            <h3>3. Vista previa y compartir</h3>
            <div class="gift-preview" id="gift-preview" hidden>
              <img id="gift-preview-img" src="" alt="" width="600" height="600" />
              <h3 id="gift-preview-name"></h3>
              <p id="gift-preview-body"></p>
              <span class="gift-watermark">Regalo imaginario / Sin valor comercial</span>
            </div>
            <div style="display:flex; flex-direction:column; gap:0.7rem; margin-top:1rem;">
              <button type="button" class="btn" id="copy-btn" hidden>Copiar enlace</button>
              <button type="button" class="btn btn-ghost" id="share-btn" hidden>Compartir regalo</button>
              <a class="btn btn-ghost" id="print-btn" hidden target="_blank" rel="noopener">Imprimir certificado</a>
            </div>
            <p id="gift-status" style="font-size:0.9rem; color:var(--muted); margin-top:0.6rem;"></p>
          </div>
        </form>
      </div>
    </section>
    <Footer />
    <script src="/scripts/bag-ui.js" defer></script>
    <script>
      import { buildGiftUrl } from '@/lib/gifts';
      const form = document.getElementById('gift-form');
      const options = form.querySelectorAll('.gift-option');
      const preview = document.getElementById('gift-preview');
      const previewImg = document.getElementById('gift-preview-img');
      const previewName = document.getElementById('gift-preview-name');
      const previewBody = document.getElementById('gift-preview-body');
      const copyBtn = document.getElementById('copy-btn');
      const shareBtn = document.getElementById('share-btn');
      const printBtn = document.getElementById('print-btn');
      const status = document.getElementById('gift-status');
      const toInput = document.getElementById('gift-to');
      const noteInput = document.getElementById('gift-note');
      const toCount = document.getElementById('gift-to-count');
      const noteCount = document.getElementById('gift-note-count');

      const names = {
        'clon-personal': 'Clon Personal 2.0',
        'cancelador-de-reuniones': 'Cancelador de Reuniones Pro',
        'borrador-de-conversaciones': 'Borrador de Conversaciones',
        'traductor-de-pensamientos': 'Traductor de Pensamientos',
        'pausador-de-tiempo': 'Pausador de Tiempo Pocket',
        'recuperador-de-sueno': 'Recuperador de Sueño 3000',
        'clima-de-bolsillo': 'Clima de Bolsillo Mini',
        'teletransportador-de-vacaciones': 'Teletransportador de Vacaciones'
      };

      let sel = { p: 'clon-personal', v: 'reuniones', to: '', note: '' };

      function esc(text) {
        const d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
      }

      function refresh() {
      options.forEach((o) => {
        const el = o as HTMLElement;
        el.classList.toggle('selected', el.dataset.p === sel.p && el.dataset.v === sel.v);
        el.setAttribute('aria-pressed', String(el.dataset.p === sel.p && el.dataset.v === sel.v));
      });
        preview.hidden = false;
        previewImg.src = `/images/products/${sel.p}.svg`;
        previewImg.alt = names[sel.p] || '';
        previewName.textContent = names[sel.p] || 'Invento imposible';
        previewBody.innerHTML = sel.note ? esc(sel.note) : 'Sin valor comercial. Tarjeta de ficción.';
        const url = buildGiftUrl(sel);
        copyBtn.hidden = false;
        shareBtn.hidden = false;
        printBtn.hidden = false;
        printBtn.href = '/regalo/?p=' + encodeURIComponent(sel.p) + '&v=' + encodeURIComponent(sel.v) + (sel.to ? '&to=' + encodeURIComponent(sel.to) : '') + (sel.note ? '&note=' + encodeURIComponent(sel.note) : '');
        status.textContent = 'Vista previa actualizada. Copia el enlace o imprime el certificado.';
      }

      options.forEach((o) => o.addEventListener('click', () => {
        const el = o as HTMLElement;
        sel.p = el.dataset.p;
        sel.v = el.dataset.v;
        refresh();
      }));

      toInput.addEventListener('input', (e) => { sel.to = e.target.value.trim(); toCount.textContent = sel.to.length + ' / 32'; refresh(); });
      noteInput.addEventListener('input', (e) => { sel.note = e.target.value.trim(); noteCount.textContent = sel.note.length + ' / 120'; refresh(); });

      copyBtn.addEventListener('click', async () => {
        const url = buildGiftUrl(sel);
        try {
          await navigator.clipboard.writeText(url);
          status.textContent = 'Enlace copiado. Que la imaginación haga el resto.';
        } catch {
          status.textContent = 'No pudimos copiar automáticamente. Selecciona y copia el enlace de abajo.';
          const field = document.createElement('input');
          field.value = url;
          field.setAttribute('aria-label', 'Enlace del regalo');
          form.appendChild(field);
          field.select();
          try { document.execCommand('copy'); } catch {}
          field.remove();
        }
      });

      shareBtn.addEventListener('click', async () => {
        const url = buildGiftUrl(sel);
        if (navigator.share) {
          try {
            await navigator.share({ title: 'Un regalo imposible de CASI REAL', text: sel.note ? `${sel.note} — ${names[sel.p]}` : `Te regalo ${names[sel.p]} (imaginario).`, url });
            status.textContent = 'Compartido.';
          } catch {
            status.textContent = 'No se pudo compartir. Copia el enlace de arriba.';
          }
        } else {
          status.textContent = 'Copia el enlace de arriba y envíaselo a quien quieras.';
        }
      });

      refresh();
    </script>
  </body>
</html>
