---
import { seoHead } from '@/components/seo-head';
import { productCard } from '@/components/product-card';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import { site } from '@/config/site';
import { loadProducts } from '@/lib/products';
import { categoryBySlug } from '@/config/categories';

const cat = categoryBySlug('trabajo')!;
const products = (await loadProducts()).filter((p) => p.data.category === 'trabajo');
const title = `${cat.name} — Inventos imposibles | CASI REAL`;
const description = cat.intro;
const url = new URL('/categorias/trabajo/', site.url).href;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    {seoHead({ title, description, url, image: site.ogImage })}
    <style is:global>@import '/src/styles/global.css';</style>
  </head>
  <body>
    <Header />
    <section class="section">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <svg aria-hidden="true"><path d="M4 8l4 4 4-4" /></svg>
          <span aria-current="page">{cat.heading}</span>
        </nav>

        <div class="category-intro">
          <h1>{cat.heading}</h1>
          <p>{cat.intro}</p>
        </div>

        <div class="product-grid">
          {products.map((p) => productCard({ product: p }))}
        </div>
        <p style="margin-top:1rem;"><a href="/productos/">Ver todo el catálogo</a></p>
      </div>
    </section>
    <Footer />
    <script src="/scripts/bag-ui.js" defer></script>
  </body>
</html>
