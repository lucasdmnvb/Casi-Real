---
import { seoHead } from '@/components/seo-head';
import { productCard } from '@/components/product-card';
import Header from '@/components/header.astro';
import Footer from '@/components/footer.astro';
import { addItem } from '@/lib/cart';
import { site } from '@/config/site';
import { loadProducts, Product } from '@/lib/products';

const products = await loadProducts();
const product = products.find((p) => p.id === 'cancelador-de-reuniones')!;
const { data } = product;
const { Content } = await product.render();
const byId = new Map(products.map((p) => [p.id, p]));
const relatedEntries = data.related.map((id) => byId.get(id)).filter(Boolean) as Product[];

const title = data.seoTitle;
const description = data.seoDescription;
const url = new URL(`/productos/${data.id}/`, site.url).href;
const image = new URL(data.image, site.url).href;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    {seoHead({ title, description, url, image })}
    <style is:global>@import '/src/styles/global.css';</style>
  </head>
  <body>
    <Header />
    <main class="section">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <svg aria-hidden="true"><path d="M4 8l4 4 4-4" /></svg>
          <a href="/categorias/trabajo/">Trabajo</a>
          <svg aria-hidden="true"><path d="M4 8l4 4 4-4" /></svg>
          <span aria-current="page">{data.title}</span>
        </nav>

        <div class="product-hero">
          <div class="product-media">
            <img src={data.image} alt={data.imageAlt} width="600" height="600" loading="eager" decoding="async" />
          </div>
          <div class="product-info">
            <span class="tag ficticio">Ficticio</span>
            <p class="disclosure" id="fiction-notice">Este invento no existe. No se vende, ni se fabrica, ni se envía.</p>
            <p class="product-eyebrow">{data.eyebrow}</p>
            <h1>{data.title}</h1>
            <p style="font-size:1.1rem; color:var(--muted); margin:0.6rem 0 1.2rem;">{data.shortDescription}</p>
            <p class="product-credits">{data.imaginaryCredits.toLocaleString('es-ES')} créditos imaginarios</p>
            <div class="product-actions">
              <button class="btn" id="focus-config">Personalizar este invento</button>
              <a href={`/regalos-imposibles/?p=${encodeURIComponent(data.id)}&v=${encodeURIComponent(data.configurator.options[0].id)}`} class="btn btn-outline">Regalar esta idea</a>
            </div>
          </div>
        </div>

        <section class="configurator" id="config-section" aria-labelledby="config-heading">
          <h3 id="config-heading">Personaliza tu {data.title}</h3>
          <p class="config-prompt">{data.configurator.prompt}</p>
          <div class="option-group" role="radiogroup" aria-label="Elige una versión">
            {data.configurator.options.map((opt) => (
              <label class="option-btn">
                <input type="radio" name="config" value={opt.id} aria-label={opt.label} />
                <span class="option-label">{opt.label}</span>
              </label>
            ))}
          </div>
          <button class="btn btn-sm" id="reveal-btn" disabled>Ver mi resultado</button>
          <div id="result" class="result-area" role="status" aria-live="polite" hidden></div>
          <div class="product-actions" style="margin-top:1rem;">
            <button class="btn btn-block btn-ghost" id="bag-btn" hidden>Agregar a mi bolsa imaginaria</button>
            <a class="btn btn-block btn-ghost" id="gift-btn" hidden>Regalar esta idea</a>
          </div>
          <script type="application/json" id="config-options">{JSON.stringify(data.configurator.options as { id: string; label: string; result: string[] }[])}</script>
          <div id="product-meta" data-id={data.id} hidden></div>
        </section>

        <script>
          const el = document.getElementById('config-section');
          const options = JSON.parse(document.getElementById('config-options').textContent);
          const group = el.querySelector('.option-group');
          const reveal = document.getElementById('reveal-btn');
          const result = document.getElementById('result');
          const bagBtn = document.getElementById('bag-btn');
          const giftBtn = document.getElementById('gift-btn');
          const productId = document.getElementById('product-meta')!.dataset.id;
          let selected = null;

          group.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement;
            if (target.tagName === 'INPUT') {
              selected = target.value;
              reveal.disabled = false;
              result.hidden = true;
              bagBtn.hidden = true;
              giftBtn.hidden = true;
            }
          });

          reveal.addEventListener('click', () => {
            if (!selected) return;
            const opt = options.find((o) => o.id === selected);
            if (!opt) return;
            result.hidden = false;
            result.textContent = opt.result;
            bagBtn.hidden = false;
            giftBtn.hidden = false;
            giftBtn.href = '/regalos-imposibles/?p=' + encodeURIComponent(productId) + '&v=' + encodeURIComponent(selected);
            window.casiRealTrack?.('select_variant', { product: productId, variant: selected });
          });

          bagBtn.addEventListener('click', () => {
            if (!selected) return;
            addItem([], productId, selected);
            const btn = bagBtn;
            const prev = btn.textContent;
            btn.textContent = 'Listo: tu invento ya vive en la bolsa.';
            btn.disabled = true;
            setTimeout(() => { btn.textContent = prev; btn.disabled = false; }, 2200);
            window.casiRealTrack?.('add_imaginary_bag', { product: productId, variant: selected });
          });
        </script>

        <article style="margin-top:2rem;">
          <h2 style="font-size:1.5rem;">Por qué este invento imposible existe (en ficción)</h2>
          <Content />
        </article>

        <section style="margin-top:2.5rem;">
          <h3>Especificaciones (ficticias)</h3>
          <table class="specs-table">
            {data.specs.map((s) => (
              <tr>
                <td>{s.label}</td>
                <td>{s.value}</td>
              </tr>
            ))}
          </table>
        </section>

        <section style="margin-top:2rem;">
          <h3>Preguntas frecuentes</h3>
          {data.faq.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>

        <section style="margin-top:2rem;">
          <h3>También podrías imaginar</h3>
          <div class="related-grid">
            {relatedEntries.map((r) => productCard({ product: r }))}
          </div>
          <p style="margin-top:0.8rem;"><a href="/productos/">Ver todo el catálogo</a></p>
        </section>

        <p style="margin-top:1.6rem; font-size:0.88rem; color:var(--muted); border-top:1px solid var(--line); padding-top:0.8rem;">
          {data.title} es un producto de ficción de CASI REAL. {data.shortDescription}
        </p>
      </div>
    </main>
    <Footer />
    <script src="/scripts/bag-ui.js" defer></script>
    <script>
      document.getElementById('focus-config')?.addEventListener('click', () => {
        const el = document.getElementById('config-section');
        if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); el.querySelector('h3')?.focus(); }
      });
    </script>
  </body>
</html>
